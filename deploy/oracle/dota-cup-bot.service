[Unit]
Description=MM Dota Cup Discord bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__APP_DIR__
ExecStart=__NPM__ run bot
Restart=always
RestartSec=8
KillSignal=SIGINT
TimeoutStopSec=20
Environment=NODE_ENV=production
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
