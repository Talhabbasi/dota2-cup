# Shared Postgres for website (Vercel) + Discord bot (Railway/Render/VPS).
# Neon / Vercel Postgres: use the *pooled* URL here (ends with -pooler for Neon).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Direct connection for `npm run db:push` (no pooler). On non-Neon hosts, set the same as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Discord bot (required to run the bot)
DISCORD_TOKEN=""
DISCORD_CLIENT_ID=""
DISCORD_GUILD_ID=""

# Discord OAuth for the website (optional — browsing works without it)
DISCORD_CLIENT_SECRET=""
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Organizer role in Discord (case-sensitive name)
ADMIN_ROLE_NAME="Admin"
# Role given to franchise captains (#captains access + #auction chat)
CAPTAIN_ROLE_NAME="Captain"

# Organizer Discord user IDs that can admin the website
ADMIN_DISCORD_IDS=""

# Weekend schedule (local cup time — default Pakistan UTC+5)
# Evening window kickoff (teams that can play 8pm–12am)
SCHEDULE_UTC_OFFSET_HOURS=5
SCHEDULE_MATCH_HOUR_LOCAL=23
SCHEDULE_MATCH_MINUTE_LOCAL=30
# Late window kickoff (teams that only overlap after midnight)
SCHEDULE_LATE_HOUR_LOCAL=0
SCHEDULE_LATE_MINUTE_LOCAL=30

# Match reminders & rules channel names (without #)
REMINDER_MINUTES_BEFORE=60
REMINDER_CHANNEL_NAME=general
RULES_CHANNEL_NAME=general
# Post pinned channel guides on bot startup (off unless you set true)
AUTO_POST_CHANNEL_RULES=false
