generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Season {
  id        String    @id @default(cuid())
  number    Int       @unique
  name      String
  status    String    @default("upcoming")
  createdAt DateTime  @default(now())
  startedAt DateTime?
  endedAt   DateTime?
  championTeamId String?
  championTeam   Team?     @relation("SeasonChampion", fields: [championTeamId], references: [id], onDelete: SetNull)

  teams        Team[]
  matches      Match[]
  fixtures     ScheduledFixture[]
  players      SeasonPlayer[]
  lots         AuctionLot[]
  payments     Payment[]
  cupSettings  CupSettings[]
  predictions  MatchPrediction[]
}

model PostedRelease {
  id        String   @id
  title     String
  messageId String?
  channelId String?
  postedAt  DateTime @default(now())
}

/// One person's registration in one season (team, captain, payment snapshot).
/// Player stays the forever identity (Discord + Steam).
model SeasonPlayer {
  id            String    @id @default(cuid())
  seasonId      String
  season        Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  playerId      String
  player        Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  teamId        String?
  team          Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  rosterRole    String?
  teamJoinedAt  DateTime?
  isCaptain     Boolean   @default(false)
  medal         String?
  rolesJson     String?
  playWindow    String?
  paidAt        DateTime?
  paymentAmount Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([seasonId, playerId])
  @@index([seasonId, teamId])
  @@index([playerId])
}

model Player {
  id          String   @id @default(cuid())
  discordId   String   @unique
  discordName String
  steam32     Int      @unique
  steamName   String
  medal       String
  rolesJson   String
  teamId      String?
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  rosterRole  String?
  teamJoinedAt DateTime?
  isCaptain   Boolean  @default(false)
  playWindow  String   @default("both")
  paidAt      DateTime?
  paymentAmount Int      @default(0)
  paymentScreenshotPath String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bids        Bid[]
  matchPlayers MatchPlayer[]
  lots        AuctionLot[]
  payments    Payment[]
  seasons     SeasonPlayer[]
  predictions MatchPrediction[]
}

model CupSettings {
  id                String   @id @default("singleton")
  registrationOpen  Boolean  @default(false)
  currentSeasonId   String?
  currentSeason     Season?  @relation(fields: [currentSeasonId], references: [id], onDelete: SetNull)
  updatedAt         DateTime @updatedAt
}

model Team {
  id        String   @id @default(cuid())
  seasonId  String?
  season    Season?  @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  name      String   @unique
  captainId String   @unique
  purse     Int
  groupKey  String?
  createdAt DateTime @default(now())
  players   Player[]
  seasonPlayers SeasonPlayer[]
  bids      Bid[]
  lotsWon   AuctionLot[]
  radiantMatches Match[] @relation("RadiantTeam")
  direMatches    Match[] @relation("DireTeam")
  wonMatches     Match[] @relation("WinnerTeam")
  radiantFixtures ScheduledFixture[] @relation("FixtureRadiant")
  direFixtures    ScheduledFixture[] @relation("FixtureDire")
  championships   Season[] @relation("SeasonChampion")
  predictedWins   MatchPrediction[] @relation("PredictedTeam")

  @@index([seasonId])
}

model AuctionState {
  id                  String    @id @default("singleton")
  status              String    @default("idle")
  role                String?
  currentLotId        String?
  currentPlayerId     String?
  currentBid          Int       @default(0)
  currentBidderTeamId String?
  endsAt              DateTime?
  queueJson           String    @default("[]")
  lastLotId           String?
  channelId           String?
  messageId           String?
}

model AuctionLot {
  id        String   @id @default(cuid())
  seasonId  String?
  season    Season?  @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  role      String
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id])
  teamId    String?
  team      Team?    @relation(fields: [teamId], references: [id])
  soldPrice Int?
  status    String
  createdAt DateTime @default(now())
  bids      Bid[]

  @@index([seasonId])
}

model Bid {
  id        String      @id @default(cuid())
  lotId     String
  lot       AuctionLot  @relation(fields: [lotId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player      @relation(fields: [playerId], references: [id])
  teamId    String
  team      Team        @relation(fields: [teamId], references: [id])
  amount    Int
  createdAt DateTime    @default(now())
}

model Match {
  id             String   @id @default(cuid())
  seasonId       String?
  season         Season?  @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  openDotaId     String   @unique
  duration       Int?
  radiantWin     Boolean?
  radiantTeamId  String?
  direTeamId     String?
  winnerTeamId   String?
  radiantTeam    Team?    @relation("RadiantTeam", fields: [radiantTeamId], references: [id])
  direTeam       Team?    @relation("DireTeam", fields: [direTeamId], references: [id])
  winnerTeam     Team?    @relation("WinnerTeam", fields: [winnerTeamId], references: [id])
  screenshotPath String?
  startedAt      DateTime?
  createdAt      DateTime @default(now())
  players        MatchPlayer[]
  scheduledFixture ScheduledFixture?

  @@index([createdAt])
  @@index([winnerTeamId])
  @@index([seasonId])
}

model ScheduledFixture {
  id            String   @id @default(cuid())
  seasonId      String?
  season        Season?  @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  radiantTeamId String
  direTeamId    String
  radiantTeam   Team     @relation("FixtureRadiant", fields: [radiantTeamId], references: [id], onDelete: Cascade)
  direTeam      Team     @relation("FixtureDire", fields: [direTeamId], references: [id], onDelete: Cascade)
  scheduledAt   DateTime
  weekendIndex  Int      @default(0)
  slotIndex     Int      @default(0)
  kind          String   @default("regular")
  bestOf        Int      @default(1)
  radiantWins   Int      @default(0)
  direWins      Int      @default(0)
  status        String   @default("scheduled")
  reminderSent  Boolean  @default(false)
  matchId       String?  @unique
  match         Match?   @relation(fields: [matchId], references: [id], onDelete: SetNull)
  slotKey       String?  @unique
  createdAt     DateTime @default(now())
  predictions   MatchPrediction[]

  @@unique([radiantTeamId, direTeamId, kind])
  @@index([seasonId])
}

/// Series-winner pick’em. Locks at kickoff. 10 pts regular, 50 grand final.
model MatchPrediction {
  id              String    @id @default(cuid())
  playerId        String
  fixtureId       String
  predictedTeamId String
  seasonId        String?
  pointsAwarded   Int       @default(0)
  scoredAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  player        Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)
  fixture       ScheduledFixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  predictedTeam Team             @relation("PredictedTeam", fields: [predictedTeamId], references: [id], onDelete: Cascade)
  season        Season?          @relation(fields: [seasonId], references: [id], onDelete: SetNull)

  @@unique([playerId, fixtureId])
  @@index([fixtureId])
  @@index([playerId, seasonId])
  @@index([seasonId, pointsAwarded])
}

model MatchPlayer {
  id       String  @id @default(cuid())
  matchId  String
  match    Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId String?
  player   Player? @relation(fields: [playerId], references: [id])
  steam32  Int
  side     String
  hero     String
  heroId   Int     @default(0)
  kills    Int
  deaths   Int
  assists  Int
  lastHits Int
  denies   Int
  gpm      Int
  xpm      Int
  itemsJson String
  unknown  Boolean @default(false)

  @@index([heroId])
}

model Hero {
  id          Int      @id
  slug        String   @unique
  name        String
  npcName     String
  primaryAttr String
  attackType  String
  rolesJson   String
  imgPath     String
  iconPath    String
  statsJson   String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Payment {
  id             String   @id @default(cuid())
  seasonId       String?
  season         Season?  @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  playerId       String
  player         Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  discordId      String
  discordName    String
  screenshotPath String
  amount         Int
  createdAt      DateTime @default(now())

  @@index([playerId])
  @@index([discordId])
  @@index([seasonId])
}
