generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Season {
  id        String    @id @default(cuid())
  /// Season count inside one game. Dota Season 1 and PUBG Season 1 can both exist.
  number    Int
  name      String
  status    String    @default("upcoming")
  /// UPCOMING | AUCTION_ACTIVE | IN_PROGRESS | COMPLETED
  phase     String    @default("UPCOMING")
  /// Exactly one season should be true — drives homepage / live cup surfaces.
  isActive  Boolean   @default(false)
  plannedStartAt DateTime?
  /// AUCTION_BASED | TEAM_BASED
  tournamentFormat String @default("AUCTION_BASED")
  teamCount Int       @default(8)
  /// DOTA | PUBG. Existing rows stay Dota.
  game      String    @default("DOTA")
  /// SOLO | DUO | SQUAD. Used only when game is PUBG.
  pubgMode  String    @default("SQUAD")
  createdAt DateTime  @default(now())
  startedAt DateTime?
  endedAt   DateTime?
  championTeamId String?
  championTeam   Team?     @relation("SeasonChampion", fields: [championTeamId], references: [id], onDelete: SetNull)

  teams        Team[]
  matches      Match[]
  fixtures     ScheduledFixture[]
  players      SeasonPlayer[]
  lots         AuctionLot[]
  payments     Payment[]
  cupSettings  CupSettings[]
  predictions  MatchPrediction[]
  bracketPicks BracketPick[]
  snapshot     SeasonSnapshot?
  captainAccounts CaptainAccount[]
  pubgLobbies  PubgLobby[]

  @@unique([game, number])
  @@index([isActive])
}

/// Frozen bracket / insights when a season is archived.
model SeasonSnapshot {
  id                  String   @id @default(cuid())
  seasonId            String   @unique
  season              Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  archivedAt          DateTime @default(now())
  championTeamId      String?
  finalScore          String?
  bracketJson         String?
  predictionsLockedAt DateTime?
  insightsJson        String?
}

model PostedRelease {
  id        String   @id
  title     String
  messageId String?
  channelId String?
  postedAt  DateTime @default(now())
}

/// One person's registration in one season (team, captain, payment snapshot).
/// Player stays the forever identity (Discord + Steam).
model SeasonPlayer {
  id            String    @id @default(cuid())
  seasonId      String
  season        Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  playerId      String
  player        Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  teamId        String?
  team          Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  rosterRole    String?
  teamJoinedAt  DateTime?
  isCaptain     Boolean   @default(false)
  medal         String?
  rolesJson     String?
  playWindow    String?
  paidAt        DateTime?
  paymentAmount Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([seasonId, playerId])
  @@index([seasonId, teamId])
  @@index([playerId])
}

model Player {
  id          String   @id @default(cuid())
  discordId   String   @unique
  discordName String
  /// Null when a PUBG player has not linked Steam.
  steam32     Int?     @unique
  steamName   String
  /// PUBG in-game name. Dota players leave this empty.
  pubgName    String?
  medal       String
  rolesJson   String
  /// UNSOLD | ON_AUCTION | SOLD (auction pool)
  auctionStatus String @default("UNSOLD")
  /// Optional auction floor; otherwise derived from medal.
  basePrice   Int?
  teamId      String?
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  rosterRole  String?
  teamJoinedAt DateTime?
  isCaptain   Boolean  @default(false)
  playWindow  String   @default("both")
  paidAt      DateTime?
  paymentAmount Int      @default(0)
  paymentScreenshotPath String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bids        Bid[]
  matchPlayers MatchPlayer[]
  lots        AuctionLot[]
  payments    Payment[]
  seasons     SeasonPlayer[]
  predictions MatchPrediction[]
  bracketPicks BracketPick[]
  aliases     PlayerAlias[]
  pubgLobbyStats PubgLobbyPlayer[]

  @@index([auctionStatus])
}

/// Admin-managed OCR / scoreboard name aliases for one player.
model PlayerAlias {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  alias     String
  createdAt DateTime @default(now())

  @@unique([alias])
  @@index([playerId])
}

/// Board names marked as stand-ins (guests). Applied across matches + future OCR.
model ScoreboardStandInName {
  id        String   @id @default(cuid())
  /// Normalized board name (same rules as PlayerAlias.alias).
  alias     String   @unique
  /// Original OCR / board label for display.
  label     String
  createdAt DateTime @default(now())
}

model CupSettings {
  id                   String   @id @default("singleton")
  registrationOpen     Boolean  @default(false)
  currentSeasonId      String?
  currentSeason        Season?  @relation(fields: [currentSeasonId], references: [id], onDelete: SetNull)
  auctionEnabled       Boolean  @default(true)
  /// Highest medal allowed to register. Null = no max. Same keys as MEDALS.
  maxMedalToApply      String?
  completeTeamRequired Boolean  @default(true)
  predictionsEnabled   Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}

model Team {
  id        String   @id @default(cuid())
  seasonId  String?
  season    Season?  @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  name      String
  tag       String?
  logoUrl   String?
  captainId String
  purse     Int
  groupKey  String?
  createdAt DateTime @default(now())
  players   Player[]
  seasonPlayers SeasonPlayer[]
  bids      Bid[]
  lotsWon   AuctionLot[]
  radiantMatches Match[] @relation("RadiantTeam")
  direMatches    Match[] @relation("DireTeam")
  wonMatches     Match[] @relation("WinnerTeam")
  radiantFixtures ScheduledFixture[] @relation("FixtureRadiant")
  direFixtures    ScheduledFixture[] @relation("FixtureDire")
  championships   Season[] @relation("SeasonChampion")
  predictedWins   MatchPrediction[] @relation("PredictedTeam")
  bracketPicks    BracketPick[] @relation("BracketPredictedTeam")
  captainAccounts CaptainAccount[]
  pubgLobbyTeams PubgLobbyTeam[]

  @@unique([seasonId, name])
  @@unique([seasonId, captainId])
  @@index([seasonId])
}

/// Single-purpose captain login for the web auction desk.
model CaptainAccount {
  id           String    @id @default(cuid())
  seasonId     String
  season       Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  teamId       String
  team         Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  loginName    String
  passcodeHash String
  token        String?   @unique
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  @@unique([seasonId, loginName])
  @@index([teamId])
  @@index([seasonId])
}

model AuctionState {
  id                  String    @id @default("singleton")
  status              String    @default("idle")
  role                String?
  currentLotId        String?
  currentPlayerId     String?
  currentBid          Int       @default(0)
  currentBidderTeamId String?
  endsAt              DateTime?
  queueJson           String    @default("[]")
  lastLotId           String?
  channelId           String?
  messageId           String?
  seasonId            String?
  awaitingDecision    Boolean   @default(false)
  event               String    @default("idle")
  /// Serialized web/live auction session (players, teams, queue, etc.).
  sessionJson         String?
  lastSaleJson        String?
  updatedAt           DateTime  @default(now()) @updatedAt
}

model AuctionLot {
  id        String   @id @default(cuid())
  seasonId  String?
  season    Season?  @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  role      String
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id])
  teamId    String?
  team      Team?    @relation(fields: [teamId], references: [id])
  soldPrice Int?
  status    String
  createdAt DateTime @default(now())
  bids      Bid[]

  @@index([seasonId])
}

model Bid {
  id        String      @id @default(cuid())
  lotId     String
  lot       AuctionLot  @relation(fields: [lotId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player      @relation(fields: [playerId], references: [id])
  teamId    String
  team      Team        @relation(fields: [teamId], references: [id])
  amount    Int
  createdAt DateTime    @default(now())
}

model Match {
  id             String   @id @default(cuid())
  seasonId       String?
  season         Season?  @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  openDotaId     String   @unique
  duration       Int?
  radiantWin     Boolean?
  radiantTeamId  String?
  direTeamId     String?
  winnerTeamId   String?
  radiantTeam    Team?    @relation("RadiantTeam", fields: [radiantTeamId], references: [id])
  direTeam       Team?    @relation("DireTeam", fields: [direTeamId], references: [id])
  winnerTeam     Team?    @relation("WinnerTeam", fields: [winnerTeamId], references: [id])
  screenshotPath String?
  radiantScore   Int?
  direScore      Int?
  startedAt      DateTime?
  createdAt      DateTime @default(now())
  players        MatchPlayer[]
  scheduledFixture ScheduledFixture?

  @@index([createdAt])
  @@index([winnerTeamId])
  @@index([seasonId])
}

model ScheduledFixture {
  id            String   @id @default(cuid())
  seasonId      String?
  season        Season?  @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  radiantTeamId String
  direTeamId    String
  radiantTeam   Team     @relation("FixtureRadiant", fields: [radiantTeamId], references: [id], onDelete: Cascade)
  direTeam      Team     @relation("FixtureDire", fields: [direTeamId], references: [id], onDelete: Cascade)
  scheduledAt   DateTime
  weekendIndex  Int      @default(0)
  slotIndex     Int      @default(0)
  kind          String   @default("regular")
  bestOf        Int      @default(1)
  radiantWins   Int      @default(0)
  direWins      Int      @default(0)
  status        String   @default("scheduled")
  reminderSent  Boolean  @default(false)
  matchId       String?  @unique
  match         Match?   @relation(fields: [matchId], references: [id], onDelete: SetNull)
  slotKey       String?  @unique
  createdAt     DateTime @default(now())
  predictions   MatchPrediction[]

  @@unique([radiantTeamId, direTeamId, kind])
  @@index([seasonId])
}

/// Series-winner pick’em. Locks at kickoff. 10 pts regular, 50 grand final.
model MatchPrediction {
  id              String    @id @default(cuid())
  playerId        String
  fixtureId       String
  predictedTeamId String
  seasonId        String?
  pointsAwarded   Int       @default(0)
  scoredAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  player        Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)
  fixture       ScheduledFixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  predictedTeam Team             @relation("PredictedTeam", fields: [predictedTeamId], references: [id], onDelete: Cascade)
  season        Season?          @relation(fields: [seasonId], references: [id], onDelete: SetNull)

  @@unique([playerId, fixtureId])
  @@index([fixtureId])
  @@index([playerId, seasonId])
  @@index([seasonId, pointsAwarded])
}

model BracketPick {
  id              String    @id @default(cuid())
  playerId        String
  seasonId        String
  slotKey         String
  predictedTeamId String
  pointsAwarded   Int       @default(0)
  scoredAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  player        Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  season        Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  predictedTeam Team   @relation("BracketPredictedTeam", fields: [predictedTeamId], references: [id], onDelete: Cascade)

  @@unique([playerId, seasonId, slotKey])
  @@index([seasonId, slotKey])
  @@index([playerId, seasonId])
}

model MatchPlayer {
  id       String  @id @default(cuid())
  matchId  String
  match    Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId String?
  player   Player? @relation(fields: [playerId], references: [id])
  steam32  Int
  side     String
  hero     String
  heroId   Int     @default(0)
  kills    Int
  deaths   Int
  assists  Int
  lastHits Int
  denies   Int
  gpm      Int
  xpm      Int
  itemsJson String
  unknown  Boolean @default(false)
  /// Admin marked this seat as a guest stand-in (not an OCR miss).
  asStandIn Boolean @default(false)
  boardName String  @default("")

  @@index([heroId])
}

model Hero {
  id          Int      @id
  slug        String   @unique
  name        String
  npcName     String
  primaryAttr String
  attackType  String
  rolesJson   String
  imgPath     String
  iconPath    String
  statsJson   String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Payment {
  id             String   @id @default(cuid())
  seasonId       String?
  season         Season?  @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  playerId       String
  player         Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  discordId      String
  discordName    String
  screenshotPath String
  amount         Int
  createdAt      DateTime @default(now())

  @@index([playerId])
  @@index([discordId])
  @@index([seasonId])
}

/// Short audit trail of organizer actions from the admin panel (and optional bot).
/// One custom-room match. Points are calculated, never typed.
model PubgLobby {
  id        String   @id @default(cuid())
  seasonId  String
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  map       String
  playedAt  DateTime
  /// scheduled = booked lobby, played = results count toward the table.
  status    String   @default("played")
  /// Organizer label so Discord can add teams to the same room ("Game 1").
  label     String   @default("")
  /// Uploaded result image. Points come from the reviewed placement and kills.
  sourceImagePath String?
  createdAt DateTime @default(now())
  teams     PubgLobbyTeam[]

  @@index([seasonId, playedAt])
}

model PubgLobbyTeam {
  id        String   @id @default(cuid())
  lobbyId   String
  lobby     PubgLobby @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  /// Empty until the lobby is played. Several teams in one scheduled lobby may be unset.
  placement Int?
  kills     Int      @default(0)
  players   PubgLobbyPlayer[]

  @@unique([lobbyId, teamId])
  @@unique([lobbyId, placement])
  @@index([teamId])
}

model PubgLobbyPlayer {
  id          String   @id @default(cuid())
  lobbyTeamId String
  lobbyTeam   PubgLobbyTeam @relation(fields: [lobbyTeamId], references: [id], onDelete: Cascade)
  playerId    String?
  player      Player?  @relation(fields: [playerId], references: [id], onDelete: SetNull)
  name        String
  kills       Int
  damage      Int      @default(0)
  knocks      Int      @default(0)

  @@index([playerId])
}

model AdminActivityLog {
  id             String   @id @default(cuid())
  actorDiscordId String
  actorName      String
  action         String
  summary        String
  metaJson       String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([actorDiscordId])
  @@index([action])
}
